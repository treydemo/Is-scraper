# ── Required ─────────────────────────────────────────────
AUDIT_API_KEY=            # long random string; Make sends it as X-API-Key
ANTHROPIC_API_KEY=        # brand extraction, answer parsing, narrative, + Claude as an AI engine
GOOGLE_API_KEY=           # Places API (New), PageSpeed Insights, YouTube Data API v3 must be enabled on this key
PUBLIC_BASE_URL=https://is-scraper-production.up.railway.app

# ── AI engines (each one you add is measured; missing ones are reported "not measured") ──
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# ── Optional ─────────────────────────────────────────────
CALLBACK_SECRET=          # if set, callbacks carry X-Audit-Signature = HMAC-SHA256(body)
BOOKING_URL=https://immersiveagentics.com/connect/
DATA_DIR=/data            # mount a Railway volume here so reports survive redeploys
MAX_CONCURRENT_JOBS=2
AI_QUERY_COUNT=6
COMPETITOR_COUNT=3
DEDUPE_DAYS=30
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5
OPENAI_MODEL=gpt-5
GEMINI_MODEL=gemini-2.5-flash
PERPLEXITY_MODEL=sonar
